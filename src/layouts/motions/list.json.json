{{- $motions := partials.IncludeCached "motions/motions-data.html" site -}}
{{- $items := slice -}}
{{- range $motions -}}
  {{- $discussion := slice -}}
  {{- $transcriptFile := path.Join "data/votes" .date "transcript.xml" -}}
  {{- if and (not .isSubvote) (os.FileExists $transcriptFile) -}}
    {{- $context := partials.IncludeCached "motions/motions-transcript-context.html" (dict "file" $transcriptFile "titles" (slice .title .sourceTitle)) .date .title .sourceTitle -}}
    {{- $discussion = $context.turns -}}
  {{- end -}}
  {{- $tracked := partials.Include "motions/motion-tracked.html" (dict "title" .title "sourceTitle" .sourceTitle "turns" $discussion) -}}
  {{- $items = $items | append (dict
    "date" .date
    "reference" .reference
    "procedureReference" .procedureReference
    "procedureURL" .procedureURL
    "procedureDocuments" .procedureDocuments
    "title" .title
    "displayTitle" .displayTitle
    "labelMepID" .labelMepID
    "labelMepName" .labelMepName
    "sourceTitle" .sourceTitle
    "parentID" .parentID
    "isSubvote" .isSubvote
    "hasSubvotes" .hasSubvotes
    "agendaRequest" .agendaRequest
    "procedure" .procedure
    "tracked" $tracked
    "result" .result
    "sourceURL" .sourceURL
    "contextURL" .contextURL
    "contextID" (printf "discussion-%s" .votingId)
    "discussion" $discussion
    "votersFor" .votersFor
    "votersAgainst" .votersAgainst
    "votersAbstaining" .votersAbstaining
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
