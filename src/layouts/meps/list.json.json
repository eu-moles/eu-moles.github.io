{{- $meps := sort (partials.IncludeCached "meps-data.html" site) "fullName" -}}
{{- $items := slice -}}
{{- range $meps -}}
  {{- $items = $items | append (dict
    "id" .id
    "fullName" .fullName
    "country" .country
    "countryFlag" (partial "country-flag.html" .country)
    "politicalGroup" .politicalGroup
    "nationalPoliticalGroup" .nationalPoliticalGroup
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
